{
  "components": {
    "securitySchemes": {
      "apiKey": {
        "description": "API Key authentication",
        "in": "header",
        "name": "x-user-access-token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Project skeleton for modern Go project",
    "title": "Go Boilerplate",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v1/account/users": {
      "post": {
        "description": "Create a new user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "confirm_password": {
                    "description": "confirm password of the user",
                    "type": "string"
                  },
                  "description": {
                    "description": "for your reference",
                    "example": "created by account department",
                    "nullable": true,
                    "type": "string"
                  },
                  "name": {
                    "description": "name of the new user",
                    "example": "John Doe",
                    "type": "string"
                  },
                  "password": {
                    "description": "password of the user",
                    "type": "string"
                  },
                  "phone_number": {
                    "description": "phone number of the user",
                    "type": "string"
                  },
                  "status": {
                    "description": "status of the user",
                    "type": "string"
                  },
                  "type": {
                    "description": "type of the user",
                    "example": "PUBLIC",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "phone_number",
                  "type",
                  "password",
                  "confirm_password",
                  "status"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "description": "the actual API returned data, empty if not success",
                      "properties": {
                        "access_token": {
                          "description": "use this access token for subsequent API calls; returned only on login",
                          "type": "string"
                        },
                        "access_token_expiry": {
                          "description": "access token expiry time",
                          "format": "date-time",
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "entry_date": {
                          "example": "2025-10-01T08:08:00Z",
                          "format": "date-time",
                          "type": "string"
                        },
                        "id": {
                          "example": 1,
                          "format": "int32",
                          "type": "integer"
                        },
                        "last_update": {
                          "example": "2025-10-01T08:08:00Z",
                          "format": "date-time",
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "phone_number": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "entry_date",
                        "last_update"
                      ],
                      "type": "object"
                    },
                    "request_id": {
                      "description": "request correlation id",
                      "type": "string"
                    },
                    "status_code": {
                      "description": "http status code",
                      "example": 200,
                      "format": "int32",
                      "type": "integer"
                    },
                    "success": {
                      "description": "is request is success",
                      "example": true,
                      "type": "boolean"
                    },
                    "time_taken": {
                      "description": "time taken in miliseconds",
                      "example": 100,
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "success",
                    "status_code",
                    "time_taken"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Successful response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "input_errors": {
                      "description": "list of input violations with details if any",
                      "items": {
                        "properties": {
                          "field": {
                            "description": "name of the input field",
                            "example": "name of the input field",
                            "type": "string"
                          },
                          "message": {
                            "description": "description of the error",
                            "example": "description of the error",
                            "type": "string"
                          }
                        },
                        "required": [
                          "field",
                          "message"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "message": {
                      "description": "error message if not success",
                      "example": "you are not admin, phone number already exists, invalid input",
                      "type": "string"
                    },
                    "request_id": {
                      "description": "request correlation id",
                      "type": "string"
                    },
                    "status_code": {
                      "description": "http status code",
                      "example": 400,
                      "format": "int32",
                      "type": "integer"
                    },
                    "success": {
                      "description": "is request is success",
                      "example": false,
                      "type": "boolean"
                    },
                    "time_taken": {
                      "description": "time taken in miliseconds",
                      "example": 100,
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "success",
                    "status_code",
                    "time_taken"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "you are not admin, phone number already exists, invalid input"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "description": "error message if not success",
                      "example": "Sorry, something is wrong with our server., internal server error",
                      "type": "string"
                    },
                    "request_id": {
                      "description": "request correlation id",
                      "type": "string"
                    },
                    "status_code": {
                      "description": "http status code",
                      "example": 500,
                      "format": "int32",
                      "type": "integer"
                    },
                    "success": {
                      "description": "is request is success",
                      "example": false,
                      "type": "boolean"
                    },
                    "time_taken": {
                      "description": "time taken in miliseconds",
                      "example": 100,
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "success",
                    "status_code",
                    "time_taken"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Sorry, something is wrong with our server., internal server error"
          },
          "default": {
            "description": ""
          }
        },
        "summary": "Create user",
        "tags": [
          "Account"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "PRODUCTION",
      "url": "https://api.example.com"
    }
  ],
  "tags": [
    {
      "name": "Account"
    }
  ]
}